#!/usr/bin/env bash
# Project-managed pre-commit hook. Activate with:
#   git config core.hooksPath .githooks
#
# Or run scripts/install-hooks.sh once after clone.

set -u

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT" || exit 1

# Only validate when SKILL.md or related skill files changed.
changed="$(git diff --cached --name-only --diff-filter=ACMRD)"

needs_validate=0
if grep -qE '^(workflows|capabilities|mandatory)/[^/]+/SKILL\.md$' <<< "$changed"; then
  needs_validate=1
fi
# Also re-validate if any public skill folder or validator contract changed.
if grep -qE '^(workflows|capabilities|mandatory)/[^/]+/(SKILL\.md|README\.md|EXAMPLE\.md|references/)|^scripts/(validate-frontmatter|test-validate-frontmatter|test-pre-commit)\.sh$' <<< "$changed"; then
  needs_validate=1
fi

if [[ "$needs_validate" -eq 1 ]]; then
  unstaged="$(git diff --name-only -- workflows capabilities mandatory scripts/validate-frontmatter.sh scripts/test-validate-frontmatter.sh scripts/test-pre-commit.sh)"
  if [[ -n "$unstaged" ]]; then
    echo "pre-commit: stage or revert scoped unstaged changes before validation:"
    printf '%s\n' "$unstaged"
    exit 1
  fi

  echo "pre-commit: validating staged public skill content..."
  bash "$ROOT/scripts/validate-frontmatter.sh" || {
    echo ""
    echo "pre-commit: SKILL.md frontmatter validation failed."
    echo "fix the errors above, then re-stage and re-commit."
    exit 1
  }
fi

exit 0
