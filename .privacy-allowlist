# Regexes matched against "path:line:token" of each denylist hit. Keep entries narrow
# and anchor them: a token is allowed only if the whole token matches.

# Addresses on reserved or noreply domains, and the SSH remote user
:[0-9]+:[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+\.(test|invalid|example)$
:[0-9]+:[A-Za-z0-9._%+-]+@example\.(com|org|net)$
:[0-9]+:[A-Za-z0-9._%+-]+@users\.noreply\.github\.com$
:[0-9]+:git@github\.com$

# CI runner home directories
:[0-9]+:.?/home/(runner|user)$

# Generic copywriting example, not a real figure
^(plugins/[a-z]+/skills/)?(workflows/)?build-landing-page/references/copywriting-formulas\.md:[0-9]+:\$10k MRR$
